<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_webhook_event_list" model="ir.ui.view">
        <field name="name">shopify.webhook.event.list</field>
        <field name="model">shopify.webhook.event</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="create_date"/>
                <field name="topic"/>
                <field name="shopify_order_id"/>
                <field name="webhook_id"/>
                <field name="account_id"/>
                <field name="state"/>
                <field name="processed_at"/>
            </list>
        </field>
    </record>

    <record id="view_shopify_webhook_event_form" model="ir.ui.view">
        <field name="name">shopify.webhook.event.form</field>
        <field name="model">shopify.webhook.event</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <field name="topic"/>
                        <field name="webhook_id"/>
                        <field name="shop_domain"/>
                        <field name="shopify_order_id"/>
                        <field name="account_id"/>
                        <field name="state"/>
                        <field name="processed_at"/>
                        <field name="error_message"/>
                    </group>
                    <group string="Payload">
                        <field name="payload_json" widget="text" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shopify_webhook_event" model="ir.actions.act_window">
        <field name="name">Shopify Webhook Events</field>
        <field name="res_model">shopify.webhook.event</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
