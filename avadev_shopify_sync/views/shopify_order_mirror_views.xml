<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_order_mirror_list" model="ir.ui.view">
        <field name="name">shopify.order.mirror.list</field>
        <field name="model">shopify.order.mirror</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="name"/>
                <field name="shopify_order_id"/>
                <field name="account_id"/>
                <field name="financial_status"/>
                <field name="fulfillment_status"/>
                <field name="total_price"/>
                <field name="currency"/>
                <field name="customer_email"/>
                <field name="shopify_updated_at"/>
            </list>
        </field>
    </record>

    <record id="view_shopify_order_mirror_form" model="ir.ui.view">
        <field name="name">shopify.order.mirror.form</field>
        <field name="model">shopify.order.mirror</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="shopify_order_id"/>
                            <field name="order_number"/>
                            <field name="account_id"/>
                        </group>
                        <group>
                            <field name="financial_status"/>
                            <field name="fulfillment_status"/>
                            <field name="currency"/>
                            <field name="total_price"/>
                            <field name="customer_email"/>
                            <field name="cancelled_at"/>
                            <field name="shopify_created_at"/>
                            <field name="shopify_updated_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list>
                                    <field name="sku"/>
                                    <field name="title"/>
                                    <field name="quantity"/>
                                    <field name="price"/>
                                    <field name="variant_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Raw JSON">
                            <field name="raw_json" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shopify_order_mirror" model="ir.actions.act_window">
        <field name="name">Shopify Orders (mirror)</field>
        <field name="res_model">shopify.order.mirror</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
