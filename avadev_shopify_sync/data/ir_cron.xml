<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_shopify_webhook_queue" model="ir.cron">
        <field name="name">Shopify: process webhook queue</field>
        <field name="model_id" ref="model_shopify_webhook_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_queue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_shopify_order_pull" model="ir.cron">
        <field name="name">Shopify: pull orders</field>
        <field name="model_id" ref="model_shopify_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_orders()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
